APP_DEBUG=true
APP_TIMEZONE=America/Bogota

# mysql en local. En Render use pgsql para Supabase.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suplos_ofertas
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# URL pública del API. Vacío en local. En Render: https://suplos-api.onrender.com
APP_URL=

# Megabytes máximos por documento PDF o ZIP.
UPLOAD_MAX_MB=10
